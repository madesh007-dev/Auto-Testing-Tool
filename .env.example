# AutoTest AI Configuration
# Copy this file to .env and adjust variables as needed

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/autotest_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace_with_your_mysql_password

# JWT Security
APP_JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
APP_JWT_EXPIRATION_MS=86400000

# CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
